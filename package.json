{
  "name": "permit-kitchener",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "vitest run",
    "test:golden": "vitest run tests/golden",
    "build": "pnpm -r build",
    "schema:json": "pnpm --filter @permit/schema gen:json",
    "test:e2e": "playwright test --trace off",
    "dev": "pnpm run \"/^dev:/\"",
    "dev:review": "uv run permit-review",
    "dev:web": "REVIEW_URL=http://localhost:8000 pnpm --filter @permit/web dev",
    "test:review": "uv run pytest -q"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "eslint": "^8.57.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "prettier": "^3.3.3",
    "typescript": "^5.5.4",
    "vitest": "^2.1.9",
    "@playwright/test": "1.63.0",
    "@axe-core/playwright": "4.10.0"
  },
  "dependencies": {
    "@permit/schema": "workspace:*",
    "@permit/engine": "workspace:*",
    "@permit/files": "workspace:*"
  }
}

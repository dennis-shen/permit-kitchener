{
  "name": "permit-kitchener",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "vitest run",
    "test:golden": "vitest run tests/golden",
    "build": "pnpm -r build",
    "schema:json": "pnpm --filter @permit/schema gen:json"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "eslint": "^8.57.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "prettier": "^3.3.3",
    "typescript": "^5.5.4",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "@permit/schema": "workspace:*",
    "@permit/engine": "workspace:*",
    "@permit/files": "workspace:*",
    "@permit/ai": "workspace:*"
  }
}

{
  "name": "permit-kitchener",
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "vitest run",
    "test:golden": "vitest run tests/golden",
    "build": "pnpm -r build",
    "test:e2e": "playwright test --trace off",
    "dev": "pnpm run \"/^dev:/\"",
    "dev:review": "uv run permit-review",
    "dev:web": "pnpm --filter @permit/web dev",
    "test:review": "uv run pytest -q",
    "start": "pnpm run \"/^start:/\"",
    "start:review": "uv run --no-dev permit-review",
    "start:web": "pnpm --filter @permit/web start"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.65.0",
    "@types/node": "^22.20.5",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@permit/engine": "workspace:*",
    "@permit/files": "workspace:*",
    "@permit/schema": "workspace:*"
  }
}

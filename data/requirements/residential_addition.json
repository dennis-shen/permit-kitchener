          "label": "Proposed floor layout",
          "missingMessage": "Add proposed floor layout.",
          "whereToAdd": "Proposed floor plan: show and label the new rooms.",
          "vision": {
            "check": "text",
            "patterns": [
              "(proposed|new) (kitchen|dining)"
            ],
            "hints": [
              "proposed floor plan",
              "proposed layout"
            ]
          }
        },
        {
          "id": "addition.floor_plan.existing_proposed_distinction",
          "label": "Distinction between existing and proposed work",
          "missingMessage": "Existing and proposed work are not clearly differentiated. Use labels, line styles or another clear method to distinguish new construction.",
          "whereToAdd": "Proposed floor plan: add a legend and use different line styles for existing and new work.",
          "vision": {
            "check": "text",
            "patterns": [
              "\\blegend\\b.*|existing to remain|new construction"
            ],
            "hints": [
              "existing",
              "proposed",
              "new",
              "demolish",
              "dashed"
            ]
          }
        },
        {
          "id": "addition.floor_plan.window_sizes",
          "label": "Proposed window sizes",
          "missingMessage": "Window information is incomplete. Add the proposed window sizes.",
          "whereToAdd": "Proposed floor plan: write the size next to each new window.",
          "vision": {
            "check": "text",
            "patterns": [
              "window\\s*\\(?\\s*\\d{3,4}\\s*[x×]\\s*\\d{3,4}"
            ],
            "hints": [
              "window size",
              "window schedule",
              "window dimensions"
            ]
          }
        },
        {
          "id": "addition.floor_plan.framing_details",
          "label": "Framing information",
          "missingMessage": "Add framing information.",
          "whereToAdd": "Floor, roof or framing plan: label joists and rafters with size and spacing.",
          "vision": {
            "check": "text",
            "patterns": [

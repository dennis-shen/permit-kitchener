{
  "$ref": "#/definitions/Evidence",
  "definitions": {
    "Evidence": {
      "type": "object",
      "properties": {
        "filename": {
          "type": "string"
        },
        "page": {
          "type": "integer",
          "exclusiveMinimum": 0
        },
        "bbox": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ]
        },
        "expectedRegion": {
          "type": "boolean",
          "default": false
        },
        "cropUrl": {
          "type": "string"
        },
        "quote": {
          "type": "string"
        },
        "value": {
          "type": [
            "string",
            "number"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "source": {
          "type": "string",
          "enum": [
            "vector",
            "ocr",
            "vlm",
            "rule",
            "form_field"
          ]
        }
      },
      "required": [
        "filename",
        "page",
        "confidence",
        "source"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}

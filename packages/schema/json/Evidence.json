{
  "title": "Evidence",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "filename": {
      "type": "string"
    },
    "page": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "bbox": {
      "type": "array",
      "prefixItems": [
        {
          "type": "number"
        },
        {
          "type": "number"
        },
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ],
      "items": false,
      "minItems": 4,
      "maxItems": 4
    },
    "expectedRegion": {
      "default": false,
      "type": "boolean"
    },
    "cropUrl": {
      "type": "string"
    },
    "quote": {
      "type": "string"
    },
    "value": {
      "type": [
        "string",
        "number"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "source": {
      "type": "string",
      "enum": [
        "rule",
        "form_field",
        "review"
      ]
    }
  },
  "required": [
    "filename",
    "page",
    "confidence",
    "source"
  ]
}

{
  "$ref": "#/definitions/ReviewResponse",
  "definitions": {
    "ReviewResponse": {
      "type": "object",
      "properties": {
        "documents": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "filename": {
                "type": "string"
              },
              "document_type": {
                "type": "string",
                "enum": [
                  "application_form",
                  "project_description",
                  "site_plan",
                  "floor_plan",
                  "existing_floor_plan",
                  "proposed_floor_plan",
                  "foundation_plan",
                  "framing_plan",
                  "roof_plan",
                  "elevations",
                  "sections_details",
                  "deck_plan",
                  "deck_side_view",
                  "key_plan",
                  "architectural_plan",
                  "plumbing_plan",
                  "hvac_plan",
                  "electrical_plan",
                  "equipment_layout",
                  "code_matrix",
                  "structural_review",
                  "mounting_system_spec",
                  "panel_spec",
                  "solar_roof_plan",
                  "other"
                ]
              },
              "shown_details": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "default": []
              },
              "detail_evidence": {
                "type": "object",
                "additionalProperties": {
                  "type": "object",
                  "properties": {
                    "filename": {
                      "type": "string"
                    },
                    "page": {
                      "type": "integer",
                      "exclusiveMinimum": 0
                    },
                    "bbox": {
                      "type": "array",
                      "minItems": 4,
                      "maxItems": 4,
                      "items": [
                        {
                          "type": "number"
                        },
                        {
                          "type": "number"
                        },
                        {
                          "type": "number"
                        },
                        {
                          "type": "number"
                        }
                      ]
                    },
                    "expectedRegion": {
                      "type": "boolean",
                      "default": false
                    },
                    "cropUrl": {
                      "type": "string"
                    },
                    "quote": {
                      "type": "string"
                    },
                    "value": {
                      "type": [
                        "string",
                        "number"
                      ]
                    },
                    "confidence": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "source": {
                      "type": "string",
                      "enum": [
                        "rule",
                        "form_field",
                        "review"
                      ]
                    }
                  },
                  "required": [
                    "filename",
                    "page",
                    "confidence",
                    "source"
                  ],
                  "additionalProperties": false
                },
                "default": {}
              }
            },
            "required": [
              "filename",
              "document_type"
            ],
            "additionalProperties": false
          }
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "category": {
                "type": "string",
                "enum": [
                  "missing",
                  "incomplete",
                  "unclear",
                  "inconsistent",
                  "wrong"
                ]
              },
              "severity": {
                "type": "string",
                "enum": [
                  "blocker",
                  "warning",
                  "info"
                ]
              },
              "requirementId": {
                "type": "string"
              },
              "detailId": {
                "type": "string"
              },
              "fileCode": {
                "type": "string",
                "enum": [
                  "WRONG_FORMAT",
                  "PASSWORD_PROTECTED",
                  "UNCLEAR_NAME",
                  "DUPLICATE",
                  "SIGNATURE_MISSING",
                  "ADDRESS_MISMATCH",
                  "COMBINED_TYPES",
                  "UNREADABLE"
                ]
              },
              "message": {
                "type": "string"
              },
              "evidence": {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/ReviewResponse/properties/documents/items/properties/detail_evidence/additionalProperties"
                },
                "default": []
              },
              "conflictsWith": {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/ReviewResponse/properties/documents/items/properties/detail_evidence/additionalProperties"
                }
              },
              "reference": {
                "type": "object",
                "properties": {
                  "requirementLabel": {
                    "type": "string"
                  },
                  "infoPkgSection": {
                    "type": "string"
                  },
                  "cityUrl": {
                    "type": "string",
                    "format": "uri"
                  },
                  "standardDetailUrl": {
                    "type": "string",
                    "format": "uri"
                  },
                  "howToFix": {
                    "type": "string"
                  },
                  "whereToAdd": {
                    "type": "string"
                  },
                  "links": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "label": {
                          "type": "string"
                        },
                        "url": {
                          "type": "string",
                          "format": "uri"
                        },
                        "kind": {
                          "type": "string",
                          "enum": [
                            "guide",
                            "form",
                            "standard_detail"
                          ],
                          "default": "guide"
                        }
                      },
                      "required": [
                        "label",
                        "url"
                      ],
                      "additionalProperties": false
                    }
                  }
                },
                "required": [
                  "requirementLabel",
                  "infoPkgSection",
                  "cityUrl",
                  "howToFix"
                ],
                "additionalProperties": false
              },
              "staffGuidance": {
                "type": "boolean"
              },
              "userOverridden": {
                "type": "boolean"
              }
            },
            "required": [
              "id",
              "category",
              "severity",
              "message"
            ],
            "additionalProperties": false
          }
        },
        "inferred_attributes": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "number",
              "boolean",
              "string"
            ]
          },
          "default": {}
        }
      },
      "required": [
        "documents",
        "findings"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}

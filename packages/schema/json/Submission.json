{
  "title": "Submission",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "application": {
      "type": "object",
      "properties": {
        "application_id": {
          "type": "string"
        },
        "applicant_name": {
          "type": "string"
        },
        "applicant_organisation": {
          "type": "string"
        },
        "property_address": {
          "type": "string"
        },
        "applicant_role": {
          "type": "string"
        },
        "project_category": {
          "type": "string",
          "enum": [
            "Residential",
            "ICI",
            "Miscellaneous"
          ]
        },
        "project_type": {
          "type": "string",
          "enum": [
            "basement_renovation",
            "deck_porch",
            "detached_garage",
            "residential_addition",
            "solar_panels",
            "ici_interior_alteration"
          ]
        },
        "project_description": {
          "type": "string"
        },
        "estimated_construction_value": {
          "type": "number",
          "minimum": 0
        },
        "submission_method": {
          "default": "Online",
          "type": "string"
        },
        "submission_date": {
          "type": "string"
        },
        "declaration_completed": {
          "type": "boolean"
        },
        "signature_present": {
          "type": "boolean"
        }
      },
      "required": [
        "application_id",
        "applicant_name",
        "property_address",
        "applicant_role",
        "project_category",
        "project_type",
        "project_description",
        "estimated_construction_value",
        "submission_date",
        "declaration_completed",
        "signature_present"
      ]
    },
    "project_attributes": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": [
          "number",
          "boolean",
          "string"
        ]
      }
    },
    "documents": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "filename": {
            "type": "string"
          },
          "document_type": {
            "type": "string",
            "enum": [
              "application_form",
              "project_description",
              "site_plan",
              "floor_plan",
              "existing_floor_plan",
              "proposed_floor_plan",
              "foundation_plan",
              "framing_plan",
              "roof_plan",
              "elevations",
              "sections_details",
              "deck_plan",
              "deck_side_view",
              "key_plan",
              "architectural_plan",
              "plumbing_plan",
              "hvac_plan",
              "electrical_plan",
              "equipment_layout",
              "code_matrix",
              "structural_review",
              "mounting_system_spec",
              "panel_spec",
              "solar_roof_plan",
              "other"
            ]
          },
          "present": {
            "type": "boolean"
          },
          "shown_details": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "complete": {
            "type": "boolean"
          },
          "issues": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "filename",
          "document_type",
          "present"
        ]
      }
    },
    "flags": {
      "default": {
        "unusual_aspects": []
      },
      "type": "object",
      "properties": {
        "unusual_aspects": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  "required": [
    "application",
    "documents"
  ]
}

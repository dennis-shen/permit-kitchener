{
  "$ref": "#/definitions/Finding",
  "definitions": {
    "Finding": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "category": {
          "type": "string",
          "enum": [
            "missing",
            "incomplete",
            "unclear",
            "inconsistent",
            "wrong"
          ]
        },
        "severity": {
          "type": "string",
          "enum": [
            "blocker",
            "warning",
            "info"
          ]
        },
        "requirementId": {
          "type": "string"
        },
        "detailId": {
          "type": "string"
        },
        "fileCode": {
          "type": "string",
          "enum": [
            "WRONG_FORMAT",
            "PASSWORD_PROTECTED",
            "UNCLEAR_NAME",
            "DUPLICATE",
            "SIGNATURE_MISSING",
            "ADDRESS_MISMATCH",
            "COMBINED_TYPES",
            "UNREADABLE"
          ]
        },
        "message": {
          "type": "string"
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "filename": {
                "type": "string"
              },
              "page": {
                "type": "integer",
                "exclusiveMinimum": 0
              },
              "bbox": {
                "type": "array",
                "minItems": 4,
                "maxItems": 4,
                "items": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  }
                ]
              },
              "expectedRegion": {
                "type": "boolean",
                "default": false
              },
              "cropUrl": {
                "type": "string"
              },
              "quote": {
                "type": "string"
              },
              "value": {
                "type": [
                  "string",
                  "number"
                ]
              },
              "confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "source": {
                "type": "string",
                "enum": [
                  "vector",
                  "ocr",
                  "vlm",
                  "rule",
                  "form_field"
                ]
              }
            },
            "required": [
              "filename",
              "page",
              "confidence",
              "source"
            ],
            "additionalProperties": false
          },
          "default": []
        },
        "conflictsWith": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Finding/properties/evidence/items"
          }
        },
        "reference": {
          "type": "object",
          "properties": {
            "requirementLabel": {
              "type": "string"
            },
            "infoPkgSection": {
              "type": "string"
            },
            "cityUrl": {
              "type": "string",
              "format": "uri"
            },
            "standardDetailUrl": {
              "type": "string",
              "format": "uri"
            },
            "howToFix": {
              "type": "string"
            }
          },
          "required": [
            "requirementLabel",
            "infoPkgSection",
            "cityUrl",
            "howToFix"
          ],
          "additionalProperties": false
        },
        "staffGuidance": {
          "type": "boolean"
        },
        "userOverridden": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "category",
        "severity",
        "message"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}

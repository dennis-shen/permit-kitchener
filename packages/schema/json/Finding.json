{
  "title": "Finding",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "missing",
        "incomplete",
        "unclear",
        "inconsistent",
        "wrong"
      ]
    },
    "severity": {
      "type": "string",
      "enum": [
        "blocker",
        "warning",
        "info"
      ]
    },
    "requirementId": {
      "type": "string"
    },
    "detailId": {
      "type": "string"
    },
    "fileCode": {
      "type": "string",
      "enum": [
        "WRONG_FORMAT",
        "PASSWORD_PROTECTED",
        "UNCLEAR_NAME",
        "DUPLICATE",
        "SIGNATURE_MISSING",
        "ADDRESS_MISMATCH",
        "COMBINED_TYPES",
        "UNREADABLE"
      ]
    },
    "message": {
      "type": "string"
    },
    "evidence": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "filename": {
            "type": "string"
          },
          "page": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "bbox": {
            "type": "array",
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              },
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "items": false,
            "minItems": 4,
            "maxItems": 4
          },
          "expectedRegion": {
            "default": false,
            "type": "boolean"
          },
          "cropUrl": {
            "type": "string"
          },
          "quote": {
            "type": "string"
          },
          "value": {
            "type": [
              "string",
              "number"
            ]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "source": {
            "type": "string",
            "enum": [
              "rule",
              "form_field",
              "review"
            ]
          }
        },
        "required": [
          "filename",
          "page",
          "confidence",
          "source"
        ]
      }
    },
    "conflictsWith": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "filename": {
            "type": "string"
          },
          "page": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "bbox": {
            "type": "array",
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              },
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "items": false,
            "minItems": 4,
            "maxItems": 4
          },
          "expectedRegion": {
            "default": false,
            "type": "boolean"
          },
          "cropUrl": {
            "type": "string"
          },
          "quote": {
            "type": "string"
          },
          "value": {
            "type": [
              "string",
              "number"
            ]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "source": {
            "type": "string",
            "enum": [
              "rule",
              "form_field",
              "review"
            ]
          }
        },
        "required": [
          "filename",
          "page",
          "confidence",
          "source"
        ]
      }
    },
    "reference": {
      "type": "object",
      "properties": {
        "requirementLabel": {
          "type": "string"
        },
        "infoPkgSection": {
          "type": "string"
        },
        "cityUrl": {
          "type": "string",
          "format": "uri"
        },
        "standardDetailUrl": {
          "type": "string",
          "format": "uri"
        },
        "howToFix": {
          "type": "string"
        },
        "whereToAdd": {
          "type": "string"
        },
        "links": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string"
              },
              "url": {
                "type": "string",
                "format": "uri"
              },
              "kind": {
                "default": "guide",
                "type": "string",
                "enum": [
                  "guide",
                  "form",
                  "standard_detail"
                ]
              }
            },
            "required": [
              "label",
              "url"
            ]
          }
        }
      },
      "required": [
        "requirementLabel",
        "infoPkgSection",
        "cityUrl",
        "howToFix"
      ]
    },
    "staffGuidance": {
      "type": "boolean"
    },
    "userOverridden": {
      "type": "boolean"
    }
  },
  "required": [
    "id",
    "category",
    "severity",
    "message"
  ]
}
